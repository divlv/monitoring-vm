# {{ ansible_managed }}
#
# Uptime Kuma {{ kuma_image | regex_replace('^.*:', '') }} on K3s, published by the bundled Traefik at https://{{ cfg.domain }}.
# Data (SQLite) lives in {{ kuma_data_dir }} on this server. One replica with the Recreate
# strategy: SQLite on a single volume must never be opened by two pods at once.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ kuma_namespace }}
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: uptime-kuma-data-pv
spec:
  capacity:
    storage: 1Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  hostPath:
    path: {{ kuma_data_dir }}
    type: DirectoryOrCreate
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: uptime-kuma-data
  namespace: {{ kuma_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
  storageClassName: "" # must stay empty, otherwise the default (local-path) class would take over
  volumeName: uptime-kuma-data-pv
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: uptime-kuma
  namespace: {{ kuma_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: uptime-kuma
  template:
    metadata:
      labels:
        app: uptime-kuma
    spec:
      # A Service called "uptime-kuma" would inject UPTIME_KUMA_PORT=tcp://..., which Kuma misreads.
      enableServiceLinks: false
      automountServiceAccountToken: false
      containers:
        - name: uptime-kuma
          image: {{ kuma_image }}
          ports:
            - containerPort: 3001
          env:
            - name: UPTIME_KUMA_DB_TYPE
              value: sqlite
            - name: TZ
              value: {{ timezone }}
          volumeMounts:
            - name: data
              mountPath: /app/data
          resources:
            requests:
              memory: {{ kuma_memory_request }}
            limits:
              memory: {{ kuma_memory_limit }}
          # The first start (database creation) is slow on 1 vCPU: allow up to 10 minutes.
          startupProbe:
            httpGet:
              path: /
              port: 3001
            periodSeconds: 5
            failureThreshold: 120
          readinessProbe:
            httpGet:
              path: /
              port: 3001
            periodSeconds: 15
            timeoutSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: 3001
            periodSeconds: 30
            timeoutSeconds: 10
            failureThreshold: 5
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: uptime-kuma-data
---
apiVersion: v1
kind: Service
metadata:
  name: uptime-kuma
  namespace: {{ kuma_namespace }}
spec:
  selector:
    app: uptime-kuma
  ports:
    - port: 3001
      targetPort: 3001
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: uptime-kuma
  namespace: {{ kuma_namespace }}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
    # "staging" or "prod" Let's Encrypt resolver, see traefik-config.yaml (key acme_use_staging).
    traefik.ingress.kubernetes.io/router.tls.certresolver: {{ acme_resolver }}
spec:
  rules:
    - host: {{ cfg.domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: uptime-kuma
                port:
                  number: 3001
